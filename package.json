{
  "name": "interview-trainer",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "面向初学者的本地优先 Java 后端与 AI/Agent 面试训练器",
  "scripts": {
    "generate": "node scripts/generate-questions.mjs",
    "validate": "node scripts/validate-data.mjs",
    "test:taxonomy": "node scripts/test-taxonomy.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:public-signals": "node scripts/test-public-question-signals.mjs",
    "test:insights": "node scripts/test-insights.mjs",
    "test:discovery": "node scripts/test-source-discovery.mjs",
    "test:content": "node scripts/test-content-reviews.mjs",
    "test:content-quality": "node scripts/test-content-quality.mjs",
    "test:learning-progress": "node scripts/test-learning-progress.mjs",
    "test:extraction-eval": "node scripts/test-extraction-eval.mjs",
    "test:server": "node scripts/test-server-api.mjs",
    "test:updater": "node scripts/test-updater.mjs",
    "test:performance": "node scripts/test-updater-performance.mjs",
    "test:resilience": "node scripts/test-updater-resilience.mjs",
    "test": "npm run test:taxonomy && npm run test:coverage && npm run test:public-signals && npm run test:insights && npm run test:discovery && npm run test:content && npm run test:content-quality && npm run test:learning-progress && npm run test:extraction-eval && npm run test:updater && npm run test:performance && npm run test:resilience && npm run test:server",
    "verify": "npm run check && npm test",
    "package:release": "node scripts/package-release.mjs",
    "package:windows": "node scripts/package-windows-portable.mjs",
    "package:checksums": "node scripts/write-release-checksums.mjs",
    "start": "node server.mjs",
    "check": "npm run generate && npm run validate"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
